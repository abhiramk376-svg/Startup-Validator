PORT=5000
NODE_ENV=development

# MongoDB — local install or MongoDB Atlas free (M0) tier both work fine.
MONGO_URI=mongodb://localhost:27017/startup-validator

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Free, cloud-hosted AI stack (Google Gemini API) ---
# No installation on any machine, no credit card — just an API key.
# 1. Go to https://aistudio.google.com/apikey and sign in with a Google
#    account.
# 2. Click "Create API key" and paste it below (same key works for both
#    chat and embeddings — Gemini's OpenAI-compatible endpoint serves both).
# This is fully OpenAI-compatible, so switching to a paid provider
# (OpenAI/Azure) later, or to a local Ollama server for offline dev, is
# just changing these values — no code changes.
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER_API_KEY=replace-with-your-free-gemini-api-key
AI_MODEL=gemini-3.6-flash

EMBEDDING_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_PROVIDER_API_KEY=replace-with-your-free-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001

# --- Avoiding "quota exceeded" / "high demand" errors (recommended) ---
# Gemini's free tier gives only ~20 requests/day per model, and one evaluation
# uses 4+. When a model is overloaded (503) or out of quota (429), the server
# automatically moves to the next backup below instead of failing.
#
# 1) Backup models on the same Gemini key (each model has its own daily quota).
#    These are the defaults; set to empty (AI_FALLBACK_MODELS=) to turn off.
AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite
#
# 2) Backup on a DIFFERENT provider — Groq has a much larger free tier and no
#    credit card. Get a key at https://console.groq.com/keys, then uncomment:
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_API_KEY=replace-with-your-free-groq-api-key
# AI_FALLBACK_MODEL=llama-3.3-70b-versatile
#
# Seconds-between-calls pacing (ms). 13000 suits Gemini's 5 requests/minute.
# AI_MIN_INTERVAL_MS=13000
# AI_FALLBACK_MIN_INTERVAL_MS=3000
# EMBEDDING_MIN_INTERVAL_MS=1000

# --- Alternative: local Ollama (offline, but requires installing Ollama) ---
# AI_PROVIDER_BASE_URL=http://localhost:11434/v1
# AI_PROVIDER_API_KEY=ollama
# AI_MODEL=llama3.1
# EMBEDDING_PROVIDER_BASE_URL=http://localhost:11434/v1
# EMBEDDING_PROVIDER_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
